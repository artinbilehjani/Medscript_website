# NEVER commit envs/prod/.env to git.

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REPLACE_ME

DEBUG=False
COMINGSOON=False

# Your actual domain(s), comma-separated
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Postgres — these are read by both Django (via DATABASE_URL)
# and the Postgres container itself (via POSTGRES_* vars)
POSTGRES_DB=medscript
POSTGRES_USER=medscript_admin
POSTGRES_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD
DATABASE_URL=postgres://medscript_admin:REPLACE_ME_WITH_STRONG_PASSWORD@db:5432/medscript
