# Keeps Docker build context small and fast.
# Without this, `docker build` sends EVERYTHING in your project
# root to the Docker daemon — including git history, postgres
# data, and node_modules if you ever add any.

.git
.gitignore
.gitattributes
postgre/
envs/
nginx/
docs/
*.md
LICENSE
locustfile.py
docker-compose*.yml

# Python cache
__pycache__
*.pyc
*.pyo
.pytest_cache

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
